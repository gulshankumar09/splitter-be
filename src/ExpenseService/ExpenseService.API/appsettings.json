{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageUpload": {
    "UploadPath": "uploads/receipts",
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".pdf"],
    "MaxFileSizeInMB": 10
  },
  "Notifications": {
    "FirebaseServerKey": "your-firebase-server-key",
    "AzureNotificationHubConnectionString": "your-azure-notification-hub-connection-string",
    "AzureNotificationHubName": "your-azure-notification-hub-name",
    "EnablePushNotifications": true
  },
  "AuthService": {
    "BaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 30
  }
}
